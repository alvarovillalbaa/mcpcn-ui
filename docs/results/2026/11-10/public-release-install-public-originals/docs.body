\"style\":{\"paddingLeft\":24},\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"h3\",null,{\"children\":\"Install the matching release packages\"}],[\"$\",\"$L28\",null,{\"label\":\"release packages\",\"command\":\"$2d\"}]]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"h3\",null,{\"children\":\"Initialize your configuration\"}],[\"$\",\"$L28\",null,{\"label\":\"initialization\",\"command\":\"node node_modules/mcpcn/dist/index.js init --mode=package --style=default --host=auto --manager=pnpm --components-dir=components/mcpcn --registry=https://raw.githubusercontent.com/alvarovillalbaa/mcpcn-ui/d91fe403eb6b3ec07ef9791e47a8655f5ed519f3/registry/items\"}]]}],\"$L2e\"]}],\"$L2f\",\"$L30\"]}]}]\ne:[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/create\",\"children\":\"Configure a different manager, theme, host or selection.\"}],\" Both modes require an existing React application. JavaScript output is not supported by this source installer.\"]}]\nf:[\"$\",\"h2\",null,{\"id\":\"provider\",\"children\":\"Mount your provider\"}]\n10:[\"$\",\"p\",null,{\"children\":[\"The generated \",[\"$\",\"code\",null,{\"children\":[\"components/mcpcn\",\"/provider.tsx\"]}],\" applies your chosen theme and creates the selected adapter on the client. Mount \",[\"$\",\"code\",null,{\"children\":\"MCPCNProvider\"}],\" around your MCP App UI. Import paths in these examples are relative to your project root; adjust them to the location of your integration file.\"]}]\n11:[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":\"\\\"use client\\\";\\n\\nimport { useEffect, useState, type ReactNode } from \\\"react\\\";\\nimport { AgentAppProvider, detectAdapter, type AgentAppAdapter } from \\\"./_mcpcn/runtime\\\";\\nimport \\\"./styles.css\\\";\\n\\nexport function MCPCNProvider({ children }: { children: ReactNode }) {\\n  const [adapter, setAdapter] = useState\u003cAgentAppAdapter | null\u003e(null);\\n  useEffect(() =\u003e { setAdapter(detectAdapter()); }, []);\\n  return \u003cdiv className=\\\"mcpcn\\\" data-mcpcn-theme=\\\"default\\\"\u003e\\n    {adapter ? \u003cAgentAppProvider adapter={adapter}\u003e{children}\u003c/AgentAppProvider\u003e\\n      : \u003cp role=\\\"status\\\" aria-busy=\\\"true\\\"\u003ePreparing app connection…\u003c/p\u003e}\\n  \u003c/div\u003e;\\n}\\n\"}]\n12:[\"$\",\"p\",null,{\"children\":[\"Copy mode includes local styles. Package mode imports \",[\"$\",\"code\",null,{\"children\":\"@mcpcn/react/styles.css\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"@mcpcn/themes/default.css\"}],\". The provider sets \",[\"$\",\"code\",null,{\"children\":\"data-mcpcn-theme\"}],\" for Default, Graphite or Violet.\"]}]\n13:[\"$\",\"h2\",null,{\"id\":\"first-component\",\"children\":\"Your first component\"}]\n14:[\"$\",\"p\",null,{\"children\":[\"For this example, add \",[\"$\",\"code\",null,{\"children\":\"approval-card\"}],\" using the configurator. Connect \",[\"$\",\"code\",null,{\"children\":\"onApprove\"}],\" to your own authorized action, and provide its pending/error handling.\"]}]\n15:[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":\"import { MCPCNProvider } from \\\"./components/mcpcn/provider\\\";\\nimport { ApprovalCard } from \\\"./components/mcpcn/approval-card\\\";\\n\\nexport function ReviewAction({ onApprove }: { onApprove: () =\u003e void }) {\\n  return \u003cMCPCNProvider\u003e\\n    \u003cApprovalCard\\n      title=\\\"Send this email?\\\"\\n      riskLevel=\\\"medium\\\"\\n      actionLabel=\\\"Send\\\"\\n      changes={[{ label: \\\"Recipients\\\", after: \\\"43 customers\\\" }]}\\n      onAction={({ type }) =\u003e { if (type === \\\"approve\\\") onApprove(); }}\\n    /\u003e\\n  \u003c/MCPCNProvider\u003e;\\n}\"}]\n16:[\"$\",\"h2\",null,{\"id\":\"host-compatibility\",\"children\":\"Host compatibility\"}]\n17:[\"$\",\"p\",null,{\"children\":[\"Auto detect uses the existing runtime detection: OpenAI compatibility when that host surface exists, the official MCP Apps adapter inside an iframe, and a local mock otherwise. Standard MCP Apps explicitly selects \",[\"$\",\"code\",null,{\"children\":\"OfficialMCPAdapter\"}],\"; OpenAI compatibility explicitly selects \",[\"$\",\"code\",null,{\"children\":\"OpenAIAdapter\"}],\". Configuration does not grant host capabilities or server permissions.\"]}]\n18:[\"$\",\"p\",null,{\"children\":\"The configurator previews are authored local examples. Their actions never execute host tools or install files, and they are not a live host acceptance check.\"}]\n19:[\"$\",\"h2\",null,{\"id\":\"security-boundaries\",\"children\":\"Security boundaries\"}]\n1a:[\"$\",\"p\",null,{\"children\":\"A UI approval is not server authorization. Keep raw personal data in private UI or server state, send only deliberate context to the model, and validate every app-initiated tool call on the server. Treat tools, membership and destructive operations as application-owned permissions.\"}]\n1b:[\"$\",\"h2\",null,{\"id\":\"registry\",\"children\":\"Registry\"}]\n1c:[\"$\",\"p\",null,{\"children\":\"The source registry contains component and workflow-block entries with their local source closure. Choose a registry you trust, review installed files, and retain the lockfile to detect changes before updating. The CLI reports required dependencies instead of running a package manager for you.\"}]\n1d:[\"$\",\"h2\",null,{\"id\":\"server-helpers\",\"children\":\"Server helpers\"}]\n1e:[\"$\",\"p\",null,{\"children\":[\"The separate \",[\"$\",\"code\",null,{\"children\":\"@mcpcn/server\"}],\" helpers support MCP tool/resource registration. Client installation does not create a server, authorization policy or production endpoint. Connect your reviewed UI to an app-visible tool in your own server integration.\"]}]\n1f:[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/docs/server\",\"children\":\"Build a validated MCP server integration\"}],\" with complete result schemas, request context, explicit private metadata and standard resource/CSP declarations.\"]}]\n20:[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/docs/reference-workflows\",\"children\":\"Run five persistent reference workflows\"}],\" with actual MCP tools, reviewed changes and a private local audit.\"]}]\n21:[\"$\",\"$L2\",null,{\"className\":\"button\",\"href\":\"/components\",\"children\":\"Explore the catalog\"}]\n22:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/immutable/chunks/09nx881wbf89m.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n23:[\"$\",\"$L31\",null,{\"children\":[\"$\",\"$32\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@33\"}]}]\n25:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L34\",null,{\"children\":\"$L35\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L36\",null,{\"children\":[\"$\",\"$32\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L37\"}]}]}],null]}]\n27:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/immutable/chunks/1wjzvi_w_58jv.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n24:C\n2a:[\"$\",\"li\",null,{\"children\":[[\"$\",\"h3\",null,{\"children\":\"Add your selected items\"}],[\"$\",\"$L28\",null,{\"label\":\"selected items\",\"command\":\"node node_modules/mcpcn/dist/index.js add review-before-action\"}]]}]\n2b:[\"$\",\"p\",null,{\"className\":\"mcpcn-hint\",\"children\":\"Step 1 installs the release and its consumer dependencies. The local CLI's generic registry dependency hint is already covered for this pinned release. Steps 2–3 prepare files and configuration; they do not create a framework app or connect a live host.\"}]\n2c:[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"children\":\"Review release archive hashes\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",\"@mcpcn/core\",{\"children\":[[\"$\",\"code\",null,{\"children\":\"mcpcn-core-0.1.0.tgz\"}],[\"$\",\"br\",null,{}],[\"$\",\"code\",null,{\"style\":{\"overflowWrap\":\"anywhere