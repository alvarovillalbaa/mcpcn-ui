cription\": \"Required for this supplied request.\"\n      },\n      {\n        \"id\": \"scope-optional\",\n        \"revision\": \"2\",\n        \"label\": \"Read authored notes\",\n        \"required\": false,\n        \"available\": true\n      },\n      {\n        \"id\": \"scope-unavailable\",\n        \"revision\": \"3\",\n        \"label\": \"Export authored records\",\n        \"required\": false,\n        \"available\": false\n      }\n    ]\n  }\n};\n\n\u003cConsentPanel {...data} onAction={intent =\u003e console.log(intent)} /\u003e5:[\"$\",\"main\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"trust\"}],[\"$\",\"h1\",null,{\"className\":\"component-heading\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":[false,\"Consent\"]}],[\"$\",\"span\",\"1\",{\"children\":[[\"$\",\"wbr\",null,{}],\"Panel\"]}]]}],[\"$\",\"p\",null,{\"className\":\"lede\",\"children\":\"Select current scopes and explicitly acknowledge them before identity-only consent intent; no permission is granted or revoked.\"}],[\"$\",\"div\",null,{\"className\":\"filter-row\",\"children\":[[\"$\",\"span\",null,{\"className\":\"pill\",\"children\":\"Domain component\"}],[\"$\",\"span\",null,{\"className\":\"pill\",\"children\":\"React\"}],[\"$\",\"span\",null,{\"className\":\"pill\",\"children\":\"Validated data\"}]]}],false,[\"$\",\"section\",null,{\"className\":\"preview-shell\",\"aria-label\":\"ConsentPanel preview\",\"children\":[\"$\",\"$Lf\",null,{\"children\":[\"$\",\"$L10\",null,{\"kind\":\"consent-panel\"}]}]}],false,[\"$\",\"section\",null,{\"className\":\"section prose\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Install\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":[\"pnpm dlx mcpcn add \",\"consent-panel\"]}],[\"$\",\"p\",null,{\"children\":\"Public npm availability is a separate release gate. The repository documentation records the currently verified source, archives and hosting profile.\"}],[[\"$\",\"h2\",null,{\"children\":\"Data props\"}],[\"$\",\"p\",null,{\"children\":\"These fields come from the actual exported schema. Defaults may be omitted on input; the schema below describes validated output. Runtime checks also validate identities, conditional values and safe evidence links.\"}],[\"$\",\"div\",null,{\"className\":\"mcpcn-table-wrap\",\"children\":[\"$\",\"table\",null,{\"className\":\"mcpcn-table\",\"children\":[[\"$\",\"caption\",null,{\"children\":[\"ConsentPanel\",\" data fields\"]}],[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"children\":\"Field\"}],[\"$\",\"th\",null,{\"children\":\"Type\"}],[\"$\",\"th\",null,{\"children\":\"Input\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"id\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"id\"}]}],[\"$\",\"td\",null,{\"children\":\"string\"}],[\"$\",\"td\",null,{\"children\":\"Required\"}]]}],[\"$\",\"tr\",\"revision\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"revision\"}]}],[\"$\",\"td\",null,{\"children\":\"string\"}],[\"$\",\"td\",null,{\"children\":\"Required\"}]]}],[\"$\",\"tr\",\"title\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"title\"}]}],[\"$\",\"td\",null,{\"children\":\"string\"}],[\"$\",\"td\",null,{\"children\":\"Required\"}]]}],[\"$\",\"tr\",\"description\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"description\"}]}],[\"$\",\"td\",null,{\"children\":\"string\"}],[\"$\",\"td\",null,{\"children\":\"Optional\"}]]}],[\"$\",\"tr\",\"state\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"state\"}]}],[\"$\",\"td\",null,{\"children\":\"string\"}],[\"$\",\"td\",null,{\"children\":\"Required\"}]]}],[\"$\",\"tr\",\"request\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"request\"}]}],[\"$\",\"td\",null,{\"children\":\"object\"}],[\"$\",\"td\",null,{\"children\":\"Optional\"}]]}],[\"$\",\"tr\",\"approveAction\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"approveAction\"}]}],[\"$\",\"td\",null,{\"children\":\"object\"}],[\"$\",\"td\",null,{\"children\":\"Optional\"}]]}],[\"$\",\"tr\",\"declineAction\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"declineAction\"}]}],[\"$\",\"td\",null,{\"children\":\"object\"}],[\"$\",\"td\",null,{\"children\":\"Optional\"}]]}],[\"$\",\"tr\",\"message\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"message\"}]}],[\"$\",\"td\",null,{\"children\":\"string\"}],[\"$\",\"td\",null,{\"children\":\"Optional\"}]]}]]}]]}]}],[\"$\",\"h2\",null,{\"children\":\"React integration\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":\"$11\"}],\"$L12\",\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$undefined\",\"$undefined\",\"$L19\"],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$undefined\"]}]]}]\n12:[\"$\",\"section\",null,{\"aria-label\":\"Privacy and context integration contract\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Current review and private data\"}],[\"$\",\"p\",null,{\"children\":\"Reported access, visibility and consent are supplied claims. A resolved callback does not grant or revoke access, send a context payload or change that report. Approval needs fresh current scopes and acknowledgement; context handoff needs a fresh complete-preview acknowledgement. Replacing the report or callback clears the draft and fences obsolete responses.\"}],[\"$\",\"p\",null,{\"children\":\"Callbacks contain current component, report and action IDs/revisions, plus approved scope or planned section IDs/revisions. Values, labels, purposes, recipients, counts and exclusion reasons stay outside those intents. JSON regions expose every supplied value for keyboard reading; zero, false, null and absent counts stay distinct.\"}],[\"$\",\"p\",null,{\"children\":\"Server-only and excluded entries accept metadata only. Keep actual server-only values out of the client payload. Visibility labels and catalogue security declarations do not enforce isolation. The structured-result helper includes its supplied data without automatic redaction; never place private review values in model-visible structuredContent or content.\"}],[\"$\",\"p\",null,{\"children\":\"The server example prepares separate model-safe metadata and a private app payload. Route the private payload through your host's approved private app channel and enforce authorization before any operation. This preparation does not send data, register a tool or configure a host policy.\"}]]}]\n13:[\"$\",\"p\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"className\"}],\" styles the surface and \",[\"$\",\"code\",null,{\"children\":\"onAction\"}],\" receives consumer-owned intent. The new domain controls and revised approval/form surfaces expose \",[\"$\",\"code\",null,{\"children\":\"busy\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"error\"}],\" feedback. Controlled selections and answers must be acknowledged by updating their props.\"]}]\n14:[\"$\",\"h2\",null,{\"children\":\"Events\"}]\n15:[\"$\",\"p\",null,{\"children\":\"This surface displays data and has no dedicated domain event contract.\"}]\n16:[\"$\",\"h2\",null,{\"children\":\"JSON Schema\"}]\n22:T1c31,{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"description\": \"Explicit current scope selection and unchecked acknowledgement before identity-only consent intent. Reported decisions do not preselect scopes; requests do not grant or revoke access.\",\n  \"oneOf\": [\n    {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$\"\n        },\n        \"revision\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$\"\n        },\n        \"title\": {\n          \"type\": \"string\",\n          \"maxLength\": 300\n        },\n        \"description\": {\n          \"type\": \"string\",\n          \"maxLength\": 4000\n        },\n        \"state\": {\n          \"type\": \"string\",\n          \"const\": \"ready\"\n        },\n        \"request\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"id\": {\n              \"type\": \"string\",\n              \"pattern\": \"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$\"\n            },\n            \"revision\": {\n              \"type\": \"string\",\n              \"pattern\": \"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$\"\n            },\n            \"label\": {\n              \"type\": \"string\",\n              \"maxLength\": 300\n            },\n            \"recipientLabel\": {\n              \"type\": \"string\",\n              \"maxLength\": 300\n            },\n            \"purpose\": {\n              \"type\": \"string\",\n              \"maxLength\": 10000\n            },\n            \"reportedDecision\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"not-recorded\",\n                \"granted\",\n                \"declined\",\n                \"revoked\",\n                \"unknown\"\n              ]\n            },\n            \"scopes\": {\n              \"minItems\": 1,\n              \"maxItems\": 20,\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"id\": {\n                    \"type\": \"string\",\n                    \"pattern\": \"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$\"\n  