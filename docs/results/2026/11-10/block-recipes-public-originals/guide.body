w\",\"children\":\"Review lifecycle\"}],[\"$\",\"a\",null,{\"href\":\"#boundaries\",\"children\":\"Data and execution boundaries\"}],[\"$\",\"a\",null,{\"href\":\"#recipes\",\"children\":\"Recipes and previews\"}]]}],[\"$\",\"article\",null,{\"className\":\"prose\",\"style\":{\"minWidth\":0},\"aria-label\":\"Persistent block recipe guide\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"UI and server together\"}],[\"$\",\"h1\",null,{\"children\":\"Make a reviewed change. Keep the result.\"}],[\"$\",\"p\",null,{\"children\":\"Each workflow block has a controlled React UI, a bound app, typed Zod schemas, a real MCP server registration, an authored input/result fixture, a runnable SDK/SQLite check and a README. The app reads the server record, prepares exact terms, confirms the reviewed change and displays its saved state and audit.\"}],\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\"]}]]}],[\"$L1b\"],\"$L1c\"]}],{},null,false,null]},null,false,\"$1d\"]},null,false,\"$1d\"]},null,false,null],\"$L1e\",false]],\"m\":\"$undefined\",\"G\":[\"$1f\",[\"$L20\"]],\"S\":true,\"h\":null,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\"}\n29:I[69110,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"OutletBoundary\"]\n2a:\"$Sreact.suspense\"\n2c:I[69110,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"ViewportBoundary\"]\n2e:I[69110,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"MetadataBoundary\"]\n5:[\"$\",\"h2\",null,{\"id\":\"install\",\"children\":\"Install one block\"}]\n6:[\"$\",\"p\",null,{\"children\":\"Install the matching CLI package archive from the repository release first. Public npm publication remains pending; these commands use the installed archive directly.\"}]\n7:[\"$\",\"pre\",null,{\"className\":\"code\",\"aria-label\":\"Block installation commands\",\"children\":\"node node_modules/mcpcn/dist/index.js init --mode=copy --host=standard-mcp\\nnode node_modules/mcpcn/dist/index.js add review-before-action\"}]\n8:[\"$\",\"p\",null,{\"children\":\"Copy mode adds editable client code and explicit .server.mts, .fixture.mts, .server.test.mts and .README.md entries under your block directory. Package mode adds equivalent thin entries using matching package archives. The CLI prints dependency commands and never installs dependencies or executes a fixture. Keep server and fixture modules out of browser imports.\"}]\n9:[\"$\",\"p\",null,{\"children\":\"Use Node 24.22.2 for the SQLite server. Copied sources use strict Bundler TypeScript and explicit emitted server .mjs modules; the caller package can use CommonJS. Package server declarations support Bundler and NodeNext. Full copied-source NodeNext compatibility remains a separate quality gate because existing client imports and pinned upstream implementation declarations contain extensionless paths.\"}]\na:[\"$\",\"pre\",null,{\"className\":\"code\",\"aria-label\":\"Bound block app entry\",\"children\":\"\\\"use client\\\";\\nimport { MCPCNProvider } from \\\"./components/mcpcn/provider\\\";\\nimport { ReviewBeforeActionApp } from \\\"./components/mcpcn/blocks/review-before-action\\\";\\n\\nexport default function App() {\\n  return \u003cMCPCNProvider\u003e\u003cReviewBeforeActionApp /\u003e\u003c/MCPCNProvider\u003e;\\n}\"}]\nb:[\"$\",\"p\",null,{\"children\":\"The record identity comes from the authorized read tool result, or an explicit id prop. Select the OpenAI adapter with --host=openai for that host. Neither adapter supplies server authentication.\"}]\nc:[\"$\",\"h2\",null,{\"id\":\"server\",\"children\":\"Wire the server-owned operation\"}]\nd:[\"$\",\"p\",null,{\"children\":\"Open an empty dedicated SQLite database in your server, supply validated initial state and resolve a trusted principal from the original verified transport context on every request. The store refuses a foreign schema. This sketch names consumer-owned state, authentication, business validation and built HTML explicitly; replace those integration points with your application.\"}]\n21:T4c3,// Server entry only. Supply a dedicated caller-opened Node24 SQLite DB.\nimport { registerReviewBeforeActionServer, BlockWorkflowStore } from \"@mcpcn/server/blocks\";\n\nconst store = new BlockWorkflowStore(database);\nstore.seed(trustedPrincipal, \"review-before-action\", \"settings-one\", serverOwnedState);\nconst registration = registerReviewBeforeActionServer(mcpServer, {\n  store,\n  policyRevision: \"settings-policy-v1\",\n  resolvePrincipal: resolveVerifiedTransportPrincipal,\n  html: builtReviewBeforeActionAppHtml,\n  executors: {\n    \"change-setting\": ({ database, principal, operation, signal }) =\u003e {\n      const change = SettingChangeSchema.parse(operation.arguments);\n      if (signal.aborted) throw new Error(\"cancelled\");\n      const update = database.prepare(\n        \"UPDATE business_settings SET value=?,revision=revision+1 \" +\n        \"WHERE workspace=? AND id=? AND revision=?\"\n      ).run(change.value, principal.workspace, change.id, change.revision);\n      if (update.changes !== 1) throw new Error(\"business_revision_conflict\");\n      return { id: change.id, revision: change.revision + 1, value: change.value };\n    }\n  }\n});\n// dispose() removes only this block's tools/resource and cancels pending work.e:[\"$\",\"pre\",null,{\"className\":\"code\",\"aria-label\":\"Transaction-local server registration\",\"children\":\"$21\"}]\nf:[\"$\",\"p\",null,{\"children\":\"Import the matching state schema from @mcpcn/schemas/blocks and the named registration from @mcpcn/server/blocks. Fixture entries show complete authored state and real revision-checked business SQL. Use fixtures only with disposable data; their fixed principal is a check identity.\"}]\n10:[\"$\",\"h2\",null,{\"id\":\"review\",\"children\":\"A review is exact and short-lived\"}]\n11:[\"$\",\"ol\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Read the authorized record and its current revision.\"}],[\"$\",\"li\",null,{\"children\":\"Submit a correction, selection or action. Prepare stores exact terms without applying the business change.\"}],[\"$\",\"li\",null,{\"children\":\"Review full values, arguments and evidence. Every new prepared review starts unchecked.\"}],[\"$\",\"li\",null,{\"children\":\"Confirm within five minutes. The server rechecks grants, actor, workspace, block, record revision, policy and captured terms before committing state, token consumption and audit.\"}],[\"$\",\"li\",null,{\"children\":\"Reload and inspect the saved outcome. An uncertain network response may follow a committed operation; another mutation stays blocked until a successful read.\"}]]}]\n12:[\"$\",\"p\",null,{\"children\":\"Cancel revokes an unconsumed review and clears its private proposal. It cannot undo a committed operation. Exact consumed-token replay returns its original receipt and the current record without running SQL again; current block access is still required. Audit history stays in SQLite; the app shows the latest 100 events and the earlier-event count.\"}]\n13:[\"$\",\"h2\",null,{\"id\":\"boundaries\",\"children\":\"Concrete execution and data boundaries\"}]\n14:[\"$\",\"p\",null,{\"children\":\"Executors are trusted synchronous functions using the same SQLite connection. Enforce current business-row revision and principal scope inside each executor. Bulk rows share one savepoint: a failed member rolls back every selected business change and records a sanitized failed outcome. Multi-step runs execute only the next eligible queued step or eligible failed step, after a separate review.\"}]\n15:[\"$\",\"p\",null,{\"children\":\"This transaction does not atomically send email, charge cards or change another service. External or asynchronous actions need your own durable idempotency, outbox and reconciliation. Report approval saves the reviewed report; it does not publish it externally.\"}]\n16:[\"$\",\"p\",null,{\"children\":\"Only deliberate block/id/revision/status/receipt fields enter public text and structured output. Complete business values, arguments, source text, review tokens and audit use app-only metadata, which the host can still read. Metadata, visibility and consent checkboxes are not authentication or proof of human identity.\"}]\n17:[\"$\",\"p\",null,{\"children\":\"Text extraction supports complete UTF-8 .txt/.md documents up to 64 KiB, preserving a BOM. Invoice labels: Supplier:, Total:, Currency:. Contract labels: Party:, Effective date:, Term:. Resume labels: Name:, Email:, Experience:. Select a file, explicitly extract it, review its complete text/hash/source matches, save that extraction, then separately review acceptance. No PDF, OCR or model provider is included.\"}]\n18:[\"$\",\"h2\",null,{\"id\":\"recipes\",\"children\":\"All eleven recipes\"}]\n19:[\"$\",\"div\",null,{\"className\":\"block-grid\",\"children\":[[\"$\",\"section\",\"review-before-action\",{\"className\":\"catalog-card\",\"aria-label\":\"review-before-action recipe\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"review-before-action\"}],[\"$\",\"p\",null,{\"children\":\"Review a planned external-state change before executing it.\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":[\"pnpm dlx mcpcn add \",\"review-before-action\"]}],[\"$\",\"a\",null,{\"href\":\"/block-recipes/review-before-action.png\",\"children\":[\"$\",\"img\",null,{\"src\":\"/block-recipes/review-before-action.png\",\"alt\":\"review-before-action saved workflow preview\",\"width\":1280,\"height\":1000,\"loading\":\"lazy\",\"style\":{\"width\":\"100%\",\"height\":\"auto\"}}]}],[\"$\",\"p\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"/r/review-before-action.json\",\"children\":\"Editable UI/server/schema/fixture/test/README payload\"}]}]]}],[\"$\",\"section\",\"collect-missing-data\",{\"className\":\"catalog-card\",\"aria-label\":\"collect-missing-data recipe\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"collect-missing-data\"}],[\"$\",\"p\",null,{\"children\":\"Ask only for fields an agent still needs.\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":[\"pnpm dlx mcpcn add \",\"collect-missing-data\"]}],[\"$\",\"a\",null,{\"href\":\"/block-recipes/collect-missing-data.png\",\"children\":[\"$\",\"img\",null,{\"src\":\"/block-recipes/collect-missing-data.png\",\"alt\":\"collect-missing-data saved workflow preview\",\"width\":1280,\"height\":1000,\"loading\":\"lazy\",\"style\":{\"width\":\"100%\",\"height\":\"auto\"}}]}],[\"$\",\"p\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"/r/collect-missing-data.json\",\"children\":\"Editable UI/server/schema/fixture/test/README payload\"}]}]]}],[\"$\",\"section\",\"extract-review-save\",{\"className\":\"catalog-card\",\"aria-label\":\"extract-review-save recipe\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"extract-review-save\"}],[\"$\",\"p\",null,{\"children\":\"Review extracted fields, evidence, and corrections before saving.\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":[\"pnpm dlx mcpcn add \",\"extract-review-save\"]}],[\"$\",\"a\",null,{\"href\":\"/block-recipes/extract-review-save.png\",\"children\":[\"$\",\"img\",null,{\"src\":\"/block-recipes/extract-review-save.png\",\"alt\":\"extract-review-save saved workflow preview\",\"width\":1280,\"height\":1000,\"loading\":\"lazy\",\"style\":{\"width\":\"100%\",\"height\":\"auto\"}}]}],[\"$\",\"p\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"/r/extract-review-save.json\",\"children\":\"Editable UI/server/schema/fixture/test/README payload\"}]}]]}],[\"$\",\"section\",\"compare-options-approve\",{\"className\":\"catalog-card\",\"aria-label\":\"compare-options-approve recipe\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"compare-options-approve\"}],[\"$\",\"p\",null,{\"children\":\"Compare options with evidence and approve the final choice.\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":[\"pnpm dlx mcpcn add \",\"compare-options-approve\"]}],[\"$\",\"a\",null,{\"href\":\"/block-recipes/compare-options-approve.png\",\"children\":[\"$\",\"img\",null,{\"src\":\"/block-recipes/compare-options-approve.png\",\"alt\":\"compare-options-approve saved workflow preview\",\"width\":1280,\"height\":1000,\"loading\":\"lazy\",\"style\":{\"width\":\"100%\",\"height\":\"auto\"}}]}],[\"$\",\"p\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"/r/compare-options-approve.json\",\"children\":\"Editable UI/server/schema/fixture/test/README payload\"}]}]]}],[\"$\",\"section\",\"multi-step-tool-run\",{\"className\":\"catalog-card\",\"aria-label\":\"multi-step-tool-run recipe\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"multi-step-tool-run\"}],[\"$\",\"p\",null,{\"children\":\"Track a recoverable multi-step tool workflow.\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":[\"pnpm dlx mcpcn add \",\"multi-step-tool-run\"]}],[\"$\",\"a\",null,{\"href\":\"/block-recipes/multi-step-tool-run.png\",\"children\":[\"$\",\"img\",null,{\"src\":\"/block-recipes/multi-step-tool-run.png\",\"alt\":\"multi-step-tool-run saved workflow preview\",\"width\":1280,\"height\":1000,\"loading\":\"lazy\",\"style\":{\"width\":\"100%\",\"height\":\"auto\"}}]}],[\"$\",\"p\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"/r/multi-step-tool-run.json\",\"children\":\"Editable UI/server/schema/fixture/test/README payload\"}]}]]}],[\"$\",\"section\",\"approval-gated-tool-call\",{\"className\":\"catalog-card\",\"aria-label\":\"approval-gated-tool-call recipe\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"approval-gated-tool-call\"}],[\"$\",\"p\",null,{\"children\":\"Require explicit consent before an app-only tool call.\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":[\"pnpm dlx mcpcn add \",\"approval-gated-tool-call\"]}],\"$L22\",\"$L23\"]}],\"$L24\",\