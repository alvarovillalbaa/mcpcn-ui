:root{--mcpcn-bg:#fff;--mcpcn-fg:#18181b;--mcpcn-muted:#71717a;--mcpcn-line:#e4e4e7;--mcpcn-accent:#6558e8;--mcpcn-accent-fg:#fff;--mcpcn-danger:#dc2626;--mcpcn-warning:#b45309;--mcpcn-success:#15803d;--mcpcn-radius:14px;--mcpcn-shadow:0 12px 32px #18181b14;--lightningcss-light:initial;--lightningcss-dark: ;color-scheme:light}.dark,[data-theme=dark]{--mcpcn-bg:#18181b;--mcpcn-fg:#fafafa;--mcpcn-muted:#a1a1aa;--mcpcn-line:#3f3f46;--mcpcn-accent:#8b7ff5;--mcpcn-shadow:0 12px 32px #0000004d;--lightningcss-light: ;--lightningcss-dark:initial;color-scheme:dark}.mcpcn{box-sizing:border-box;color:var(--mcpcn-fg);font:14px/1.5 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif}.mcpcn *{box-sizing:border-box}.mcpcn-sr-only{clip:rect(0,0,0,0);white-space:nowrap;border:0;width:1px;height:1px;margin:-1px;padding:0;position:absolute;overflow:hidden}.mcpcn-row{flex-wrap:wrap}.mcpcn-code{overflow-wrap:anywhere;max-width:100%}.mcpcn input:focus-visible,.mcpcn select:focus-visible,.mcpcn textarea:focus-visible,.mcpcn a:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 45%,transparent);outline-offset:3px}.mcpcn-card{background:var(--mcpcn-bg);border:1px solid var(--mcpcn-line);border-radius:var(--mcpcn-radius);box-shadow:var(--mcpcn-shadow);overflow:hidden}.mcpcn-header,.mcpcn-body,.mcpcn-footer{padding:18px}.mcpcn-header+.mcpcn-body,.mcpcn-body+.mcpcn-footer{border-top:1px solid var(--mcpcn-line)}.mcpcn-title{letter-spacing:-.01em;margin:0;font-size:16px;font-weight:680;line-height:1.3}.mcpcn-description{color:var(--mcpcn-muted);margin:6px 0 0}.mcpcn-row{align-items:center;gap:10px;display:flex}.mcpcn-between{justify-content:space-between}.mcpcn-stack{grid-template-columns:minmax(0,1fr);gap:12px;display:grid}.mcpcn-button{appearance:none;background:var(--mcpcn-accent);color:var(--mcpcn-accent-fg);font:inherit;cursor:pointer;border:1px solid #0000;border-radius:9px;padding:9px 13px;font-weight:650}.mcpcn-button:hover{filter:brightness(.96)}.mcpcn-button:focus-visible,.mcpcn-input:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 35%,transparent);outline-offset:2px}.mcpcn-button[data-variant=secondary]{color:var(--mcpcn-fg);border-color:var(--mcpcn-line);background:0 0}.mcpcn-button[data-variant=danger]{background:var(--mcpcn-danger)}.mcpcn-button:disabled{opacity:.55;cursor:not-allowed}.mcpcn-badge{background:color-mix(in srgb,var(--mcpcn-accent) 12%,transparent);color:var(--mcpcn-accent);border-radius:999px;padding:3px 8px;font-size:12px;font-weight:700;display:inline-flex}.mcpcn-badge[data-risk=high],.mcpcn-badge[data-risk=critical]{color:var(--mcpcn-danger);background:color-mix(in srgb,var(--mcpcn-danger) 12%,transparent)}.mcpcn-badge[data-risk=medium]{color:var(--mcpcn-warning)}.mcpcn-change{border-bottom:1px solid var(--mcpcn-line);grid-template-columns:minmax(100px,1fr) 1fr auto;gap:12px;padding:11px 0;display:grid}.mcpcn-change:last-child{border:0}.mcpcn-before{color:var(--mcpcn-muted);text-decoration:line-through}.mcpcn-after{font-weight:600}.mcpcn-input{border:1px solid var(--mcpcn-line);background:var(--mcpcn-bg);width:100%;color:var(--mcpcn-fg);font:inherit;border-radius:9px;padding:9px 11px}.mcpcn-label{gap:5px;font-weight:600;display:grid}.mcpcn-hint{color:var(--mcpcn-muted);font-size:12px}.mcpcn-progress{grid-template-columns:22px 1fr;gap:10px;display:grid}.mcpcn-progress-line{justify-items:center;display:grid}.mcpcn-progress-line:after{content:"";background:var(--mcpcn-line);width:1px}.mcpcn-progress:last-child .mcpcn-progress-line:after{display:none}.mcpcn-dot{border:2px solid var(--mcpcn-line);background:var(--mcpcn-bg);border-radius:50%;width:12px;height:12px;margin-top:4px}.mcpcn-dot[data-status=running]{border-color:var(--mcpcn-accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--mcpcn-accent) 15%,transparent)}.mcpcn-dot[data-status=succeeded]{background:var(--mcpcn-success);border-color:var(--mcpcn-success)}.mcpcn-dot[data-status=failed]{background:var(--mcpcn-danger);border-color:var(--mcpcn-danger)}.mcpcn-table-wrap{overflow:auto}.mcpcn-table{border-collapse:collapse;width:100%}.mcpcn-table th,.mcpcn-table td{text-align:left;border-bottom:1px solid var(--mcpcn-line);padding:10px}.mcpcn-table th{color:var(--mcpcn-muted);text-transform:uppercase;letter-spacing:.04em;font-size:12px}.mcpcn-error{border:1px solid color-mix(in srgb,var(--mcpcn-danger) 30%,var(--mcpcn-line));background:color-mix(in srgb,var(--mcpcn-danger) 6%,var(--mcpcn-bg));border-radius:var(--mcpcn-radius);padding:16px}.mcpcn-code{white-space:pre-wrap;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}@media (width<=520px){.mcpcn-change{grid-template-columns:1fr}.mcpcn-footer{display:grid}.mcpcn-footer .mcpcn-button{width:100%}}@media (prefers-reduced-motion:reduce){.mcpcn *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}.mcpcn-file-root{overflow-wrap:anywhere;min-width:0;max-width:100%}.mcpcn-file-details{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 18px;margin:0;display:grid}.mcpcn-file-details>div{min-width:0}.mcpcn-file-details dt{color:var(--mcpcn-muted);font-size:12px}.mcpcn-file-details dd{white-space:pre-wrap;overflow-wrap:anywhere;margin:2px 0 0}.mcpcn-file-viewport{border:1px solid var(--mcpcn-line);overscroll-behavior:contain;border-radius:9px;min-width:0;max-width:100%;max-height:min(70vh,42rem);padding:14px;overflow:auto}.mcpcn-file-viewport:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 45%,transparent);outline-offset:3px}.mcpcn-file-text{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:0}.mcpcn-file-figure{min-width:0;margin:0}.mcpcn-file-figure figcaption{color:var(--mcpcn-muted);margin-top:8px}.mcpcn-file-image{max-width:100%;height:auto;display:block}.mcpcn-file-save{border-top:1px solid var(--mcpcn-line);min-width:0;padding-top:14px}.mcpcn-file-save h4{margin:0}.mcpcn-file-save h4:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 45%,transparent);outline-offset:3px}.mcpcn-file-root .mcpcn-button{min-height:44px}.mcpcn-file-root .mcpcn-label{min-width:0}@media (width<=520px){.mcpcn-file-details{grid-template-columns:minmax(0,1fr)}.mcpcn-file-viewport{padding:10px}}.mcpcn-source-root,.mcpcn-evidence-root{overflow-wrap:anywhere;min-width:0;max-width:100%}.mcpcn-source-list{gap:16px;margin:0;padding:0;list-style:none;display:grid}.mcpcn-source-item{border:1px solid var(--mcpcn-line);border-radius:9px;min-width:0;padding:14px}.mcpcn-source-description{overflow-wrap:anywhere;min-width:0}.mcpcn-source-description h4{margin:0}.mcpcn-source-description p{margin:8px 0}.mcpcn-source-excerpt{white-space:pre-wrap}.mcpcn-source-root .mcpcn-button,.mcpcn-evidence-root .mcpcn-button,.mcpcn-evidence-dialog .mcpcn-button{min-height:44px}.mcpcn-evidence-dialog:not([open]),.mcpcn-evidence-dialog[data-presentation-open=false]{display:none}.mcpcn-evidence-dialog{border:1px solid var(--mcpcn-line);background:var(--mcpcn-bg);width:min(44rem,100% - 16px);max-width:100%;height:100dvh;max-height:100dvh;color:var(--mcpcn-fg);box-shadow:var(--mcpcn-shadow);margin:0;padding:0;position:fixed;inset:0 0 0 auto;overflow:hidden}.mcpcn-evidence-dialog[open][data-presentation-open=true]{flex-direction:column;display:flex}.mcpcn-evidence-dialog::backdrop{background:#00000073}.mcpcn-evidence-dialog>.mcpcn-header{border-bottom:1px solid var(--mcpcn-line);flex:none;gap:14px}.mcpcn-evidence-dialog .mcpcn-title{overflow-wrap:anywhere;min-width:0}.mcpcn-evidence-content{overscroll-behavior:contain;min-width:0;max-width:100%;min-height:0;padding:18px;overflow:auto}.mcpcn-evidence-text{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:0}.mcpcn-evidence-dialog .mcpcn-title:focus-visible,.mcpcn-evidence-content:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 45%,transparent);outline-offset:-3px}@media (width<=520px){.mcpcn-evidence-dialog>.mcpcn-header{align-items:flex-start;padding:14px}.mcpcn-evidence-content{padding:14px}}.mcpcn-evidence-dialog .mcpcn-evidence-content pre{max-height:none;overflow:visible}.mcpcn-inspection-root{overflow-wrap:anywhere;min-width:0;max-width:100%}.mcpcn-inspection-fields{gap:12px;margin:0;padding:0;list-style:none;display:grid}.mcpcn-inspection-field{border:1px solid var(--mcpcn-line);border-radius:9px;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;min-width:0;padding:14px;display:flex}.mcpcn-inspection-summary{gap:4px;min-width:0;display:grid}.mcpcn-inspection-confidence{gap:4px;display:grid}.mcpcn-inspection-confidence meter{width:min(18rem,100%)}.mcpcn-inspection-root .mcpcn-button{min-height:44px}.mcpcn-inspection-text{white-space:pre-wrap;overflow-wrap:anywhere}.mcpcn-inspection-content{overscroll-behavior:contain;border:1px solid var(--mcpcn-line);border-radius:9px;min-width:0;max-width:100%;max-height:min(70vh,42rem);padding:16px;overflow:auto}.mcpcn-inspection-content h4{margin-top:0}.mcpcn-inspection-content:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 45%,transparent);outline-offset:3px}.mcpcn-inspection-root .mcpcn-inspection-content pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:none;overflow:visible}.mcpcn-inspection-evidence{padding-left:20px}.mcpcn-inspection-evidence li{min-width:0}.mcpcn-inspection-evidence p{margin:8px 0}@media (width<=520px){.mcpcn-inspection-field{align-items:flex-start}.mcpcn-inspection-content{padding:12px}}.mcpcn-cv-root{overflow-wrap:anywhere;min-width:0;max-width:100%}.mcpcn-cv-members{gap:12px;margin:0;padding:0;list-style:none;display:grid}.mcpcn-cv-member{border:1px solid var(--mcpcn-line);border-radius:9px;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;min-width:0;padding:14px;display:flex}.mcpcn-cv-summary{gap:4px;min-width:0;display:grid}.mcpcn-cv-confidence{gap:4px;display:grid}.mcpcn-cv-confidence meter{width:min(18rem,100%)}.mcpcn-cv-root .mcpcn-button{min-height:44px}.mcpcn-cv-text{white-space:pre-wrap;overflow-wrap:anywhere}.mcpcn-cv-content{overscroll-behavior:contain;border:1px solid var(--mcpcn-line);border-radius:9px;min-width:0;max-width:100%;max-height:min(70vh,42rem);padding:16px;overflow:auto}.mcpcn-cv-content h4{margin-top:0}.mcpcn-cv-content:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 45%,transparent);outline-offset:3px}.mcpcn-cv-root .mcpcn-cv-content pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:none;overflow:visible}.mcpcn-cv-evidence{padding-left:20px}.mcpcn-cv-evidence li{min-width:0}.mcpcn-cv-evidence p{margin:8px 0}.mcpcn-cv-confirmation{justify-items:start;gap:8px;display:grid}@media (width<=520px){.mcpcn-cv-member{align-items:flex-start}.mcpcn-cv-content{padding:12px}}.mcpcn-or-root{overflow-wrap:anywhere;min-width:0;max-width:100%}.mcpcn-or-members{gap:12px;margin:0;padding:0;list-style:none;display:grid}.mcpcn-or-member{border:1px solid var(--mcpcn-line);border-radius:9px;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;min-width:0;padding:14px;display:flex}.mcpcn-or-summary,.mcpcn-or-ranking,.mcpcn-or-confidence{gap:4px;min-width:0;display:grid}.mcpcn-or-confidence meter{width:min(18rem,100%)}.mcpcn-or-root .mcpcn-button{min-height:44px}.mcpcn-or-text{white-space:pre-wrap;overflow-wrap:anywhere}.mcpcn-or-content{overscroll-behavior:contain;border:1px solid var(--mcpcn-line);border-radius:9px;min-width:0;max-width:100%;max-height:min(70vh,42rem);padding:16px;overflow:auto}.mcpcn-or-content h4{margin-top:0}.mcpcn-or-content:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 45%,transparent);outline-offset:3px}.mcpcn-or-root .mcpcn-or-content pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:none;overflow:visible}.mcpcn-or-evidence{padding-left:20px}.mcpcn-or-evidence li{min-width:0}.mcpcn-or-evidence p{margin:8px 0}@media (width<=520px){.mcpcn-or-member{align-items:flex-start}.mcpcn-or-content{padding:12px}}.mcpcn-dn{overflow-wrap:anywhere;min-width:0;max-width:100%}.mcpcn-dn-text{white-space:pre-wrap;overflow-wrap:anywhere}.mcpcn-dn-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:20px;min-width:0;display:grid}.mcpcn-dn-grid>section,.mcpcn-dn-option{min-width:0}.mcpcn-dn-option{border:1px solid var(--mcpcn-line);border-radius:9px;padding:16px}.mcpcn-dn-json{overscroll-behavior:contain;border:1px solid var(--mcpcn-line);border-radius:6px;min-width:0;max-width:100%;max-height:20rem;padding:12px;overflow:auto}.mcpcn-dn-json pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:none;margin:0;overflow:visible}.mcpcn-dn-json:focus-visible{outline:3px solid color-mix(in srgb,var(--mcpcn-accent) 45%,transparent);outline-offset:3px}.mcpcn-dn .mcpcn-button{min-height:44px}*{box-sizing:border-box}body{margin:0;font:14px/1.5 system-ui,sans-serif}.frame-app{color:#18181b;overflow-wrap:anywhere;background:#fafafa;min-height:100vh;padding:18px}.frame-app.dark{color:#f4f4f5;--lightningcss-light: ;--lightningcss-dark:initial;color-scheme:dark;background:#18181b}.frame-app>header{flex-wrap:wrap;justify-content:space-between;gap:12px;font-size:12px;display:flex}.frame-hint{color:#71717a;font-size:12px}.dark .frame-hint{color:#a1a1aa}.frame-requests{flex-wrap:wrap;gap:8px;margin:20px 0;display:flex}.frame-requests>button{color:inherit;font:inherit;cursor:pointer;background:0 0;border:1px solid #a1a1aa;border-radius:7px;padding:8px 10px}.frame-requests>button:disabled{opacity:.45;cursor:default}.frame-app details{margin:12px 0}.frame-app summary{cursor:pointer}.frame-app pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:240px;font-size:12px;overflow:auto}.frame-app>[role=alert]{color:#be123c}.frame-app.dark>[role=alert]{color:#fda4af}@media (width<=480px){.frame-app{padding:12px}.frame-requests>button{flex:42%}}
