}</pre><h2>Structured tool result</h2><pre class="code">import { ReasoningSummarySchema } from &quot;@mcpcn/schemas&quot;;
import { createStructuredResult } from &quot;@mcpcn/server&quot;;

export function reviewedResult(candidate: unknown) {
  const data = ReasoningSummarySchema.parse(candidate);
  return createStructuredResult(&quot;reasoning-summary&quot;, data);
}</pre><h2>Security contract</h2><p>Previews use authored data and consumer callbacks. Applications own authorization, persistence, tool execution and explicit model-context publication.</p><p><strong>Declared model-visible fields:</strong> <!-- -->id, revision, summary.id, summary.revision, action.id, action.revision</p><p><strong>Private fields:</strong> <!-- -->title, description, message, summary.label, summary.overview, summary.points, summary.limitations, action.label, action.available, requestFeedback</p><p><strong>Declared consumer tool intents:</strong> <!-- -->None</p><p><strong>Destructive intent:</strong> <!-- -->No by default</p><h2>Host and keyboard behavior</h2><p>Host integration uses the consuming application&#x27;s runtime provider. Native inputs, buttons, links and semantic tables expose the local interactions shown above. External-host compatibility and full accessibility conformance require their own acceptance evidence.</p></section></main><!--$--><!--/$--><footer><div><strong>MCPCN</strong><p>Human control for agentic apps.</p></div><div><a href="/llms.txt">llms.txt</a><a href="https://github.com/alvarovillalbaa/mcpcn-ui">GitHub</a><a href="https://github.com/alvarovillalbaa/mcpcn-ui/blob/main/SECURITY.md">Security</a></div></footer><script src="/_next/static/immutable/chunks/1ddg70z30qn04.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n2:I[14058,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"\"]\n3:I[43820,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"default\"]\n4:I[98737,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"default\"]\n6:I[69110,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"OutletBoundary\"]\n7:\"$Sreact.suspense\"\na:I[69110,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"ViewportBoundary\"]\nc:I[69110,[\"/_next/static/immutable/chunks/29nm6-6cbu5hi.js\"],\"MetadataBoundary\"]\ne:I[98025,