*{box-sizing:border-box}body{color:#f4f4f5;background:#111113;margin:0;font:14px/1.5 system-ui,sans-serif}.studio{background:#323238;grid-template-columns:minmax(230px,280px) minmax(0,1fr);grid-template-areas:"header header""controls preview""editor trace";gap:1px;min-height:100vh;display:grid}.studio-header{background:#18181b;flex-wrap:wrap;grid-area:header;justify-content:space-between;align-items:center;gap:10px;padding:14px 20px;display:flex}.studio-header>div{gap:3px;display:grid}.studio-header span,.hint{color:#a1a1aa;font-size:12px}.host-controls{background:#18181b;grid-area:controls;min-width:0;padding:18px}.studio h1{margin:0 0 14px;font-size:22px;line-height:1.2}.studio h2{margin:18px 0 8px;font-size:14px}.studio label{color:#d4d4d8;gap:6px;margin:14px 0;font-size:12px;display:grid}.studio label.toggle{align-items:flex-start;gap:8px;display:flex}.toggle>input{margin:3px 0 0}.studio select,.studio button{color:#fafafa;font:inherit;background:#27272a;border:1px solid #52525b;border-radius:7px;min-width:0;max-width:100%;padding:9px}.studio button{cursor:pointer;background:#6757d8;width:100%;margin:5px 0;font-weight:600}.studio button.secondary{background:#27272a}.studio button:disabled{opacity:.45;cursor:default}.studio :is(button,select,textarea,input):focus-visible{outline-offset:2px;outline:2px solid #c4b5fd}.chat{color:#d4d4d8;overflow-wrap:anywhere;background:#27272a;border-radius:9px;padding:12px;font-size:12px}.preview-area{background:#232326;grid-area:preview;min-width:0;padding:18px}.preview-bar{background:#18181b;border-radius:9px 9px 0 0;flex-wrap:wrap;justify-content:space-between;gap:8px;padding:9px 12px;font-size:12px;display:flex}.frame-viewport{background:#fafafa;border:1px solid #52525b;border-radius:9px;max-width:100%;margin:18px auto;overflow:hidden}.app-frame{background:#fafafa;border:0;width:100%;height:780px;display:block}.editor-area{grid-area:editor}.trace-area{grid-area:trace}.editor-area,.trace-area{background:#18181b;min-width:0;padding:18px}.studio textarea,.studio pre{color:#c4b5fd;background:#111113;border:1px solid #52525b;border-radius:7px;width:100%;padding:12px;font:12px/1.6 ui-monospace,monospace}.studio textarea{resize:vertical;min-height:160px}.editor-area label:nth-of-type(2) textarea{min-height:330px}.studio pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:360px;overflow:auto}.studio details>summary{cursor:pointer}.button-row{flex-wrap:wrap;gap:8px;display:flex}.button-row>button{flex:140px}.trace-area ol{color:#86efac;background:#111113;border:1px solid #52525b;border-radius:7px;min-height:240px;max-height:460px;margin:0;padding:12px;font-size:12px;list-style:none;overflow:auto}.trace-area li{overflow-wrap:anywhere;flex-wrap:wrap;gap:8px;padding:5px 0;display:flex}.trace-area time{color:#a1a1aa}.trace-area code{white-space:pre-wrap;overflow-wrap:anywhere}.studio-error{color:#fda4af;overflow-wrap:anywhere}@media (width<=900px){.studio{grid-template-columns:minmax(0,1fr);grid-template-areas:"header""controls""preview""editor""trace"}.host-controls{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px;display:grid}.host-controls>:is(h1,p,section){grid-column:1/-1}}@media (width<=480px){.host-controls{display:block}.preview-area,.editor-area,.trace-area,.studio-header{padding:12px}.app-frame{height:760px}}
