\n        \"label\": \"Payment terms source\",\n        \"text\": \"Payment terms: 30 days\",\n        \"pageId\": \"page-2\"\n      }\n    ]\n  },\n  \"extraction\": {\n    \"id\": \"authored-extraction-1\",\n    \"revision\": \"1\",\n    \"fileId\": \"authored-file-1\",\n    \"fileRevision\": \"1\",\n    \"fields\": [\n      {\n        \"id\": \"supplier\",\n        \"label\": \"Supplier\",\n        \"original\": \"Acme Labs\",\n        \"value\": \"Acme Labs\",\n        \"required\": true,\n        \"confidence\": 0.97,\n        \"evidence\": [\n          {\n            \"id\": \"supplier-line\",\n            \"label\": \"Authored supplier line\",\n            \"text\": \"Supplier: Acme Labs\"\n          }\n        ]\n      },\n      {\n        \"id\": \"total\",\n        \"label\": \"Total\",\n        \"original\": \"EUR 48.20\",\n        \"value\": \"EUR 48.20\",\n        \"required\": true,\n        \"confidence\": 0.91,\n        \"evidence\": [\n          {\n            \"id\": \"total-line\",\n            \"label\": \"Authored total line\",\n            \"text\": \"Total: EUR 48.20\"\n          }\n        ]\n      }\n    ]\n  }\n});\n  const [last, setLast] = useState\u003cComponentAction | null\u003e(null);\n  const handleAction = (action: ComponentAction) =\u003e {\n    setLast(action);\n    const scope = action.data as { reviewId?: string; fileId?: string; fileRevision?: string; extractionId?: string; extractionRevision?: string; fieldId?: string; value?: string } | undefined;\n    if (action.type === \"file-correction-change\" \u0026\u0026 scope?.reviewId === data.id \u0026\u0026 data.file \u0026\u0026 data.extraction \u0026\u0026 scope.fileId === data.file.id \u0026\u0026 scope.fileRevision === data.file.revision \u0026\u0026 scope.extractionId === data.extraction.id \u0026\u0026 scope.extractionRevision === data.extraction.revision) {\n      setData(current =\u003e {\n        if (!current.file || !current.extraction || scope.reviewId !== current.id || scope.fileId !== current.file.id || scope.fileRevision !== current.file.revision || scope.extractionId !== current.extraction.id || scope.extractionRevision !== current.extraction.revision) return current;\n        return { ...current, extraction: { ...current.extraction, fields: current.extraction.fields.map(field =\u003e field.id === scope.fieldId \u0026\u0026 !field.disabled \u0026\u0026 typeof scope.value === \"string\" ? { ...field, value: scope.value } : field) } };\n      });\n    }\n    // save-file-review is intent only. Independently validate scope, values,\n    // authorization and persistence in your application before claiming success.\n  };\n  return \u003c\u003e\n    \u003cFileReview {...data} onAction={handleAction} /\u003e\n    \u003cpre aria-label=\"Last file review intent\"\u003e{JSON.stringify(last, null, 2)}\u003c/pre\u003e\n  \u003c/\u003e;\n}5:[\"$\",\"main\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"data-review\"}],[\"$\",\"h1\",null,{\"children\":\"FileReview\"}],[\"$\",\"p\",null,{\"className\":\"lede\",\"children\":\"Review a current file representation and extracted corrections before explicit scoped save intent.\"}],[\"$\",\"div\",null,{\"className\":\"filter-row\",\"children\":[[\"$\",\"span\",null,{\"className\":\"pill\",\"children\":\"Domain component\"}],[\"$\",\"span\",null,{\"className\":\"pill\",\"children\":\"React\"}],[\"$\",\"span\",null,{\"className\":\"pill\",\"children\":\"Validated data\"}]]}],false,[\"$\",\"section\",null,{\"className\":\"preview-shell\",\"aria-label\":\"FileReview preview\",\"children\":[\"$\",\"$Lf\",null,{\"children\":[\"$\",\"$L10\",null,{}]}]}],[\"$\",\"section\",null,{\"className\":\"section prose\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Install\"}],[\"$\",\"pre\",null,{\"className\":\"code\",\"children\":[\"pnpm dlx mcpcn add \",\"file-review\"]}],[\"$\",\"p\",null,{\"children\":\"Public npm availability is a separate release gate. The repository do