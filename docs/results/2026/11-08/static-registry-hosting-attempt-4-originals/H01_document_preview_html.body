 save intents deliberately contain reviewed private values. PrivateOnly catalogue metadata does not redact content already passed to a model. Keep private documents in app-only state and publish model context explicitly.\"}]]\n13:[\"$\",\"p\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"className\"}],\" styles the surface and \",[\"$\",\"code\",null,{\"children\":\"onAction\"}],\" receives consumer-owned intent. The new domain controls and revised approval/form surfaces expose \",[\"$\",\"code\",null,{\"children\":\"busy\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"error\"}],\" feedback. Controlled selections and answers must be acknowledged by updating their props.\"]}]\n14:[\"$\",\"h2\",null,{\"children\":\"Events\"}]\n15:[\"$\",\"div\",null,{\"className\":\"mcpcn-table-wrap\",\"children\":[\"$\",\"table\",null,{\"className\":\"mcpcn-table\",\"children\":[[\"$\",\"caption\",null,{\"children\":[\"DocumentPreview\",\" action payloads\"]}],[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"children\":\"Action type\"}],[\"$\",\"th\",null,{\"children\":\"Data\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"document-page-change\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"document-page-change\"}]}],[\"$\",\"td\",null,{\"children\":[\"$\",\"code\",null,{\"children\":\"{ previewId, fileId, fileRevision, pageId }\"}]}]]}],[\"$\",\"tr\",\"document-source-change\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":[\"$\",\"code\",null,{\"children\":\"document-source-change\"}]}],[\"$\",\"td\",null,{\"children\":[\"$\",\"code\",null,{\"children\":\"{ previewId, fileId, fileRevision, sourceId, pageId?; no content }\"}]}]]}]]}]]}]}]\n16:[\"$\",\"h2\",null,{\"children\":\"JSON Schema\"}]\n22:T3567,{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"oneOf\": [\n    {\n      \"type\": \"object\",\n      \"propertie