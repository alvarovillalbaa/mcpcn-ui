{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tool-call-card",
  "type": "registry:ui",
  "title": "ToolCallCard",
  "description": "Transparent tool execution and recovery: ToolCallCard.",
  "dependencies": [
    "@mcpcn/core",
    "@mcpcn/schemas",
    "react"
  ],
  "registryDependencies": [
    "button",
    "card",
    "badge"
  ],
  "files": [
    {
      "path": "components/mcpcn/tool-call-card.tsx",
      "type": "registry:component",
      "content": "import { ToolCallCard } from \"@mcpcn/react\"\nexport { ToolCallCard }\n"
    }
  ],
  "meta": {
    "category": "tool-execution",
    "security": {
      "modelVisible": [
        "decision",
        "userInput"
